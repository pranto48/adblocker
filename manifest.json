{
  "manifest_version": 3,
  "name": "AmpBlock Pro",
  "version": "1.3.1",
  "description": "Ultra-powerful Ad & Popup Blocker — YouTube Ultra Buster v4.0, Anti-Adblock Defuser, Element Zapper, and 128 DNR Rules.",
  "author": "Arif (https://arifmahmud.com/)",
  "homepage_url": "https://itsupport.com.bd",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AmpBlock Pro"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/ad-defuser.js",
        "content/popup-blocker.js",
        "content/security-sentinel.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/youtube-buster.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/element-zapper.js",
        "content/security-sentinel.js",
        "content/quarantine-shield.css",
        "content/cosmetic-filter.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
